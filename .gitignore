__pycache__/
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
/cache/
# The demo page is a build artifact: rebuilt by demo/build_pages.py and uploaded
# by the Pages workflow, never edited by hand. Ignoring the whole directory to
# exclude it also swallowed hand-written documentation put beside it, silently.
/docs/index.html

# Local scratch: exploration notebooks. Notebooks carry execution state and
# outputs, which diff badly and would drift from the code they demonstrate.
/notebooks/

# Retrieval corpora and comparison outputs. The corpus is a few hundred PubMed
# abstracts under publisher copyright; it is rebuildable via scripts/build_corpus.py
# in one command, so it is not redistributed here.
/data/
